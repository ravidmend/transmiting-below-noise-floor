    rotation: 0
    state: enabled
- name: hackathon_decoder_0_0
  id: hackathon_decoder
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    pn_len: pn_len
    recived_amp: '1'
    sps: sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 312.0]
    rotation: 0
    state: enabled
- name: hackathon_encoder_2_0
  id: hackathon_encoder
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    pn_len: pn_len
    sps: sps
